# Goal
geometry_msgs/PoseStamped[] poses  # Array of target poses to navigate through
float32 speed                      # Desired speed for navigation

---
# Result
bool success                       # Whether all poses were navigated successfully
string message                     # Optional message for debugging or failure

---
# Feedback
int32 current_pose_index           # Index of the currently active pose
geometry_msgs/PoseStamped current_pose  # Current pose of the drone
