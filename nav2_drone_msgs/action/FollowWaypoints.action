# Goal
geometry_msgs/PoseStamped[] waypoints  # Array of waypoints to visit
float32 speed                          # Desired speed for navigation

---
# Result
bool success                           # Whether all waypoints were visited successfully
string message                         # Optional message for debugging or failure

---
# Feedback
int32 current_waypoint_index           # Index of the currently active waypoint
geometry_msgs/PoseStamped current_pose # Current pose of the drone
